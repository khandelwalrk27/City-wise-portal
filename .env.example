# Backend Server Port
PORT=5000

# SQLite Local Database Location
DB_PATH=database/citywise.sqlite

# JWT Token Secret Key
JWT_SECRET=citywise_jaipur_secret_key_2026

# Optional External AI API Key (Service works with rule-based fallback if omitted)
OPENAI_API_KEY=

# ====================================================
# SUPABASE POSTGRESQL DATABASE CONFIGURATION (OPTIONAL)
# ====================================================
# Paste your Supabase project URL and keys below:
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Direct PostgreSQL Connection String (Optional for direct pg client):
# DATABASE_URL=postgresql://postgres.xxx:xxx@aws-0-us-east-1.pooler.supabase.com:5432/postgres
